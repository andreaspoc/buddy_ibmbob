# ./start.sh creates .env from this file and generates its passwords and signing keys.
# Never share or commit .env.
# Optional: you can instead add the key, or skip it, in the setup wizard on first open.
BOB_API_KEY=
BOB_TEAM_ID=
# Optional. Only used before the wizard saves a name, and when upgrading an existing install.
BUDDY_NAME=
BUDDY_ORGANIZATION=
# Optional. This email is granted administrator access on first database creation.
BUDDY_INITIAL_ADMIN_EMAIL=

# Used by docker-compose.yml to create the bundled PostgreSQL database.
# Changing these does not rename users/databases in an existing database volume.
POSTGRES_USER=bob
POSTGRES_DB=bob
POSTGRES_PASSWORD=

# Required by BOTH Compose files. Use your EXISTING connection when upgrading.
# For bundled PostgreSQL: postgresql://bob:URL_ENCODED_PASSWORD@postgres:5432/bob
# For remote PostgreSQL: postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE
# Password characters in this URL must be percent-encoded.
DATABASE_URL=

BOB_BIND_IP=0.0.0.0
BOB_PORT=3000
BOB_ALT_PORT=8080
# Required for remote deployment: the address users open in their browser.
PUBLIC_BASE_URL=

KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Leave blank to derive the callback from PUBLIC_BASE_URL.
KEYCLOAK_REDIRECT_URI=
KEYCLOAK_ADMIN_SUBJECTS=
# Optional fallback IP for the hostname in KEYCLOAK_ISSUER if DNS fails.
KEYCLOAK_HOST_IP=
BOB_LOCAL_LOGIN_ENABLED=0

BRAVE_API_KEY=
BRAVE_SEARCH_API=https://api.search.brave.com/res/v1/web/search
BOB_API_UPSTREAM=https://api.us-east.bob.ibm.com
BOB_INTERNAL_A2A_URL=http://bob-agent:8080/a2a

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
# Leave blank to derive the callback from the browser request.
AZURE_REDIRECT_URI=
GRAPH_SCOPES=offline_access,User.Read,Mail.Read,Mail.ReadWrite,Mail.Send,Calendars.ReadWrite,Contacts.ReadWrite,MailboxFolder.Read,MailboxFolder.ReadWrite,MailboxSettings.Read
GRAPH_API_BASE=https://graph.microsoft.com/v1.0

BOB_FILE_STORAGE=postgres
BOB_S3_BUCKET=
BOB_S3_ACCESS_KEY_ID=
BOB_S3_SECRET_ACCESS_KEY=
BOB_S3_REGION=
BOB_S3_ENDPOINT=

DEFAULT_TIMEZONE=UTC
BOB_REQUEST_TIMEOUT=900
BOB_PRESENTATION_TIMEOUT=1800
BOB_OLLAMA_URL=http://host.docker.internal:11434
BOB_EMBEDDING_MODEL=granite-embedding:278m

BOB_CPU_LIMIT=2.0
BOB_MEMORY_LIMIT=2048M
BOB_CPU_RESERVATION=0.5
BOB_MEMORY_RESERVATION=512M
KNOWLEDGE_CPU_LIMIT=2.0
KNOWLEDGE_MEMORY_LIMIT=4G
POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=512M
POSTGRES_CPU_RESERVATION=0.25
POSTGRES_MEMORY_RESERVATION=128M

# Required when enabling the office compose profile (use a random 64-character value).
OFFICE_JWT_SECRET=

# Optional Docmost launcher. Empty allowlists hide the entry from everyone.
DOCMOST_URL=
DOCMOST_ALLOWED_USERS=
# Existing profile groups: administrators,buddy,company_b,project_team
DOCMOST_ALLOWED_GROUPS=
# Enable only after Docmost allows the Buddy origin to embed it.
DOCMOST_EMBED=0

# Independent release images. Build the shared runtime once before building services.
BUDDY_RUNTIME_IMAGE=bob-acp-runtime:1.1.0
BUDDY_CORE_IMAGE=bob-acp-core:1.1.0
BUDDY_OFFICE_IMAGE=bob-acp-office:1.1.0
BUDDY_PEOPLE_IMAGE=bob-acp-people:1.1.0
BUDDY_PROJECTS_IMAGE=bob-acp-projects:1.1.0
# Default is main Buddy chat only. Enable plugins through Compose overlays or
# scripts/deploy_buddy.py; do not set internal service URLs for disabled plugins.
BUDDY_OFFICE_ENABLED=0
BUDDY_PEOPLE_ENABLED=0
BUDDY_PROJECTS_ENABLED=0

# Administrator-only SSRF exception for intentional internal A2A/MCP services.
# Comma-separated exact origins (scheme://host:port); no paths, wildcards or redirects implied.
# Leave empty to permit only public destinations on ports 80/443 by default.
BOB_A2A_ALLOWED_ORIGINS=
BOB_MCP_ALLOWED_ORIGINS=
# A2A only: permit public HTTP(S) agents on any port without individual grants.
# DNS/IP checks still block private, loopback, link-local and reserved addresses.
# Internal agents still require an exact BOB_A2A_ALLOWED_ORIGINS entry. MCP is unchanged.
BOB_A2A_ALLOW_PUBLIC_PORTS=0
# A2A only: trust hosts explicitly listed above across HTTP(S) schemes and ports.
# Other private hosts and metadata/loopback/link-local addresses remain blocked.
# HTTPS is recommended; enable only for hosts you trust to receive agent requests.
BOB_A2A_RELAXED_ORIGINS=0

# Overlap isolated ACP initialization with per-job context reads (0 disables).
BOB_AGENT_PREWARM=1

# Agent execution safeguards. Set a persistent random signing key (at least 32 characters).
BUDDY_MEMORY_SIGNING_KEY=
BUDDY_AGENT_MAX_TOOL_CALLS=100
BUDDY_AGENT_MAX_INFERENCE_CALLS=16
BUDDY_AGENT_MAX_REMOTE_CALLS=6
BUDDY_AGENT_MAX_SPECIALIST_CALLS=6
BUDDY_AGENT_MAX_DAILY_ACTIONS=1000
BUDDY_AGENT_MAX_RUN_SECONDS=3600

# DecisionsBuddy (PostgreSQL persistence, optional separate feature service)
BUDDY_DECISIONS_ENABLED=0
BUDDY_DECISIONS_PLUGIN_URL=
BUDDY_DECISIONS_GOVERNANCE_TTL_SECONDS=3600
# Optional separate key; otherwise uses BUDDY_MEMORY_SIGNING_KEY. Keep it stable.
BUDDY_CP4D_ENCRYPTION_KEY=

# Optional Learning Buddy plugin (Keycloak group paths are exact).
BUDDY_LEARNING_ENABLED=0
BUDDY_LEARNING_PLUGIN_URL=
BUDDY_LEARNING_TEACHER_GROUP=/teacher
