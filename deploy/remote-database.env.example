# Copy these values into the ignored project .env file. Never commit credentials.
# Use a direct PostgreSQL endpoint, not a transaction-pooling endpoint (LISTEN/NOTIFY).
DATABASE_URL=postgresql://bob:URL_ENCODED_PASSWORD@YOUR_DATABASE_HOST:5432/bob?sslmode=verify-full
# Keep your existing Bob, Keycloak, Microsoft and other runtime settings.
BOB_API_KEY=YOUR_EXISTING_BOB_API_KEY
BOB_TEAM_ID=YOUR_EXISTING_TEAM_ID
