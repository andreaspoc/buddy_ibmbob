FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HOME=/models/huggingface
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 tesseract-ocr tesseract-ocr-eng \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libsasl2-2)" ge '2.1.28+dfsg-10+deb12u1' \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-knowledge.txt /opt/bob-a2a/requirements-knowledge.txt
RUN pip install --no-cache-dir -r /opt/bob-a2a/requirements-knowledge.txt \
    --extra-index-url https://download.pytorch.org/whl/cpu
RUN groupadd --gid 10001 buddy && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/buddy buddy \
    && mkdir -p /models/huggingface /models/cache \
    && chown 10001:10001 /models /models/huggingface /models/cache
ENV XDG_CACHE_HOME=/models/cache
COPY app /opt/bob-a2a/app
WORKDIR /opt/bob-a2a
USER 10001:10001
CMD ["python", "-m", "app.rag_worker"]
